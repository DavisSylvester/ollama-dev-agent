# Ollama server URL
#   Local:  http://localhost:11434
#   Cloud:  https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud API key (only needed when OLLAMA_BASE_URL points at https://ollama.com).
# Get one at https://ollama.com/settings/keys. Leave blank for local Ollama.
OLLAMA_API_KEY=

# Model names
#   Local examples:  qwen3.5:35b / qwen3-coder:30b / devstral-small-2
#   Cloud examples:  use the names returned by `GET <base>/api/tags` for your account
PLANNER_MODEL=qwen3.5:35b
CODER_MODEL=qwen3-coder:30b
EDITOR_MODEL=devstral-small-2

# Ralph loop settings
MAX_ITERATIONS=5
MAX_REACT_STEPS=20
REVIEWER_MAX_STEPS=8
# Wall-clock cap per worker iteration (seconds)
MAX_ITERATION_SECONDS=1200
# Cap on ONE model request (seconds). A hung call is aborted at the HTTP level
# and retried; retries never run past the iteration's wall clock.
CALL_TIMEOUT_SECONDS=180

# Quota / rate limits: on a "usage limit" or 429 the run saves state and waits
# QUOTA_PAUSE_MINUTES before retrying, for at most QUOTA_MAX_PAUSE_MINUTES in
# total, then stops cleanly (re-run the same command to resume).
QUOTA_PAUSE_MINUTES=15
QUOTA_MAX_PAUSE_MINUTES=360

# Before each batch, upgrade outdated direct dependencies to their newest
# release, keeping only upgrades that don't make typecheck/lint/tests worse.
# Decisions are written to docs/DEPENDENCIES.md in the target project.
# Overridden per-run by the --no-dep-upgrade CLI flag.
DEP_UPGRADE=true

# Shell for shell_exec. Default: Git Bash → PowerShell 7 → Windows PowerShell on
# Windows (never WSL or cmd.exe); bash → /bin/sh on macOS/Linux. Set a path or
# name (bash, pwsh, powershell) to override.
# ODA_SHELL=

# Research-enabled planning (PRD generation step budget)
PLANNER_MAX_STEPS=15

# Web-search planning: true (default) or false for a fast single-shot PRD.
# Overridden per-run by the --no-research CLI flag.
RESEARCH_PLANNING=true

# Web search
BRAVE_API_KEY=

# Logging
LOG_LEVEL=info
LOG_FILE=.oda.log
